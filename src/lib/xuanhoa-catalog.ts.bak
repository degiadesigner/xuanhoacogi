  banhTrang55Items[19], // BÁNH TRÁNG 55 NVL: Trà chanh tươi mát (10k)
  banhTrang55Items[20], // BÁNH TRÁNG 55 NVL: Trà tắc chua ngọt mát lạnh (10k)
  ...quanBaThuDrinkDishes,
  ...leHuyenDrinkDishes,
  ...canteenKtxDrinkDishes,
  ...officialDrinkDishes
];


export function getCategoryItems(cat: MainCategoryKey): Food[] {
  let list: Food[];
  switch (cat) {
    case 'an-gi':
      list = anGiFoods;
      break;
    case 'nhau-gi':
      list = nhauGiFoods;
      break;
    case 'uong-gi':
      list = uongGiItems;
      break;
    default:
      list = anGiFoods;
  }
  return list.map(f => ({
    ...f,
    rarity: priceRarity(f.price),
  }));
}

export interface CatalogFoodItem extends Food {
  categoryKey: MainCategoryKey;
  categoryLabel: string;
}

export function getAllCatalogFoods(): CatalogFoodItem[] {
  const seen = new Set<string>();
  const all: CatalogFoodItem[] = [];

  const addItems = (items: Food[], key: MainCategoryKey, label: string) => {
    for (const f of items) {
      const idKey = f.customId || `${f.name}-${f.price}`;
      if (!seen.has(idKey)) {
        seen.add(idKey);
        all.push({
          ...f,
          rarity: priceRarity(f.price),
          categoryKey: key,
          categoryLabel: label,
        });
      }
    }
  };

  addItems(anGiFoods, 'an-gi', 'Bữa Chính & Cơm Bún Phở');
  addItems(nhauGiFoods, 'nhau-gi', 'Món Nhậu & Lẩu Nướng');
  addItems(uongGiItems, 'uong-gi', 'Đồ Uống & Trà Sữa');

  return all;
}

// Trích xuất mã nhận diện concept món ăn (chuẩn hóa định danh món độc bản, tránh trùng lặp)
export function getDishConceptKey(food: Food): string {
  const name = food.name.toLowerCase();
  
  // Đồ uống đặc thù
  if (name.includes('cold whisk') || name.includes('matcha giòn')) return 'cold-whisk-matcha-gion';
  if (name.includes('hokkaido')) return 'tra-sua-hokkaido';
  if (name.includes('matcha sữa dừa')) return 'matcha-sua-dua';
  if (name.includes('sinh tố bơ')) return 'sinh-to-bo';
  if (name.includes('trà bí đao')) return 'tra-bi-dao';
  if (name.includes('tàu hũ')) return 'tau-hu';
  if (name.includes('dưa lưới')) return 'tra-dua-luoi';
  if (name.includes('socola bơ lạc')) return 'socola-bo-lac';
  if (name.includes('nước mía')) return 'nuoc-mia';
  if (name.includes('sữa chua thạch trà')) return 'sua-chua-thach-tra';
  if (name.includes('sữa chua')) return 'sua-chua';
  if (name.includes('việt quất')) return 'viet-quat-lac-sua';
  if (name.includes('sen vàng') || name.includes('trà sen')) return 'tra-sen';
  if (name.includes('matcha')) return 'matcha';
  if (name.includes('trà dâu')) return 'tra-dau';
  if (name.includes('trà đào')) return 'tra-dao';
  if (name.includes('trà chanh') || name.includes('trà tắc') || name.includes('trà quất')) return 'tra-chanh';
  
  // Các dòng Trà sữa khác biệt
  if (name.includes('kem trứng dừa nướng')) return 'tra-sua-kem-trung-dua';
  if (name.includes('trà sữa bơ')) return 'tra-sua-bo';
  if (name.includes('đường đen')) return 'tra-sua-duong-den';
  if (name.includes('mochi')) return 'tra-sua-mochi';
  if (name.includes('kem dừa nướng') || name.includes('trà sáp')) return 'tra-sua-kem-dua';
  if (name.includes('ba anh em')) return 'tra-sua-3-anh-em';
  if (name.includes('trà sữa')) return 'tra-sua';
  
  // Các dòng Cà phê khác biệt
  if (name.includes('cà phê muối') || name.includes('cafe muối')) return 'ca-phe-muoi';
  if (name.includes('cà phê dừa') || name.includes('cốt dừa') || name.includes('sữa dừa dầm')) return 'ca-phe-dua';
  if (name.includes('kem trứng')) return 'ca-phe-kem-trung';
  if (name.includes('bạc xỉu')) return 'bac-xiu';
  if (name.includes('cà phê') || name.includes('cafe')) return 'ca-phe';
  
  // Bún, phở, bánh cuốn, bánh xèo
  if (name.includes('bún đậu')) return 'bun-dau';
  if (name.includes('bún chả')) return 'bun-cha';
  if (name.includes('bún cá')) return 'bun-ca';
  if (name.includes('bún bò')) return 'bun-bo';
  if (name.includes('bún trộn')) return 'bun-tron';
  if (name.includes('bánh cuốn')) return 'banh-cuon';
  if (name.includes('trứng chảy')) return 'banh-xeo-trung-chay';
  if (name.includes('bánh xèo')) return 'banh-xeo';
  if (name.includes('bánh mì chảo')) return 'banh-mi-chao';
  if (name.includes('sốt bơ vàng')) return 'banh-mi-sot-bo-vang';
  if (name.includes('thập cẩm cắt')) return 'banh-mi-thap-cam-cat';
  if (name.includes('bánh mì que') || name.includes('bánh mỳ que')) return 'banh-mi-que';
  if (name.includes('bánh mì nướng muối ớt') || name.includes('bánh mì muối ớt') || name.includes('bánh mỳ muối ớt')) return 'banh-mi-nuong-muoi-ot';
  if (name.includes('bánh mì sốt bơ')) return 'banh-mi-bo-mat-ong';
  if (name.includes('bánh mì thịt nướng') || name.includes('bánh mỳ thịt nướng') || name.includes('kẹp thịt nướng')) return 'banh-mi-thit-nuong';
  if (name.includes('thịt xiên nướng') || name.includes('thịt xiên')) return 'thit-xien-nuong';
  if (name.includes('lạp xưởng nướng đá')) return 'lap-xuong-nuong-da';
  if (name.includes('dồi sụn')) return 'doi-sun';
  if (name.includes('bánh mì') || name.includes('bánh mỳ')) return 'banh-mi';
  if (name.includes('phở')) return 'pho';
  
  // Cơm
  if (name.includes('cơm rang dứa') || name.includes('cơm rang trái dứa')) return 'com-rang-dua';
  if (name.includes('cơm rang kim chi')) return 'com-rang-kimchi';
  if (name.includes('cơm rang dưa bò')) return 'com-rang-duabo';
  if (name.includes('cơm rang đùi gà') || name.includes('cơm rang gà')) return 'com-rang-ga';
  if (name.includes('thập cẩm') && name.includes('cơm rang')) return 'com-rang-thap-cam';
  if (name.includes('cơm rang')) return 'com-rang';
  if (name.includes('cơm nắm')) return 'com-nam';
  if (name.includes('trứng thịt băm') || name.includes('trứng đúc thịt')) return 'com-trung-thit';
  if (name.includes('xúc xích') && name.includes('cơm')) return 'com-trung-xuc-xich';
  if (name.includes('cơm tấm') || name.includes('cơm sườn') || name.includes('cơm trắng')) return 'com-dia';
  
  // Đồ nướng & Lẩu
  if (name.includes('bò củ quả') || (name.includes('bò') && name.includes('trung hoa'))) return 'xien-bo-trung-hoa';
  if (name.includes('cánh gà') && (name.includes('trung hoa') || name.includes('sốt cay'))) return 'canh-ga-nuong-trung-hoa';
  if (name.includes('mực nguyên con')) return 'muc-nguyen-con-nuong';
  if (name.includes('tuộc baby')) return 'tuoc-baby-nuong';
  if (name.includes('nộm cải thảo')) return 'nom-cai-thao-trung';
  if (name.includes('nộm đậu bắp')) return 'nom-dau-bap-trung';
  if (name.includes('vương lão cát') || name.includes('trà thảo mộc trung')) return 'tra-thao-moc-trung';
  if (name.includes('chân giò') && name.includes('nướng')) return 'chan-gio-nuong';
  if (name.includes('đậu nướng')) return 'dau-nuong';
  if (name.includes('buffet nướng') || name.includes('buffet')) return 'buffet-nuong';
  if (name.includes('nướng chảo gang') || name.includes('nướng chảo')) return 'nuong-chao-gang';
  if (name.includes('nầm nướng')) return 'nam-nuong';
  if (name.includes('lẩu ếch')) return 'lau-ech';
  if (name.includes('lẩu thái') || name.includes('lẩu hải sản')) return 'lau-thai';
  if (name.includes('lẩu riêu')) return 'lau-rieu';
  if (name.includes('lẩu')) return 'lau';
  
  // Món xào & món nhậu
  if (name.includes('mì xào mọc') || name.includes('mỳ xào mọc')) return 'mi-xao-moc';
  if (name.includes('mì xào bò') || name.includes('mỳ xào bò')) return 'mi-xao-bo';
  if (name.includes('mì xào') || name.includes('mì trộn')) return 'mi-xao';
  if (name.includes('gân bò')) return 'gan-bo-chay-toi';
  if (name.includes('bò xào cần') || name.includes('bò xào tỏi')) return 'bo-xao-can-toi';
  if (name.includes('bò lúc lắc')) return 'bo-luc-lac';
  if (name.includes('chim bồ câu') || name.includes('chim câu')) return 'chim-bo-cau';
  if (name.includes('cá chép giòn') || name.includes('cá xào')) return 'ca-chep-gion';
  if (name.includes('mực')) return 'muc';
  if (name.includes('trâu')) return 'trau-chay-toi';
  
  // Bia & Món nhậu Tuấn Hiền
  if (name.includes('bia hơi')) return 'bia-hoi';
  if (name.includes('ba chỉ quay') || name.includes('ba chỉ giòn')) return 'ba-chi-quay';
  if (name.includes('nộm tai heo') || name.includes('nộm tai')) return 'nom-tai-heo';
  if (name.includes('lòng xào dưa') || name.includes('lòng xào')) return 'long-xao-dua';
  if (name.includes('đậu phụ rán') || name.includes('đậu tẩm hành')) return 'dau-tam-hanh';
  if (name.includes('trâu gác bếp')) return 'trau-gac-bep';
  
  // Món nhậu & Lẩu Nhà Hàng Sân Bia 247
  if (name.includes('nem ngựa')) return 'nem-ngua';
  if (name.includes('tháp sườn')) return 'thap-suon';
  if (name.includes('má đào') && name.includes('cháy tỏi')) return 'ma-dao-chay-toi';
  if (name.includes('nõn đuôi')) return 'non-duoi-moc-mat';
  if (name.includes('tóp mỡ triều khúc')) return 'top-mo-trieu-khuc';
  if (name.includes('lẩu tôm bầu')) return 'lau-tom-bau';
  if (name.includes('tôm rum')) return 'lau-thai-tom-rum';
  if (name.includes('tôm sông nướng')) return 'tom-song-nuong';
  if (name.includes('tràng trứng cháy tỏi') || name.includes('tràng trứng')) return 'trang-trung-chay-toi';
  if (name.includes('cá chép om dưa')) return 'ca-chep-om-dua';
  if (name.includes('đậu phụ sốt tóp mỡ')) return 'dau-sot-top-mo';
  if (name.includes('gỏi bắp bò')) return 'goi-bap-bo';

  // Món nhậu & Lẩu Vành Đai Quán
  if (name.includes('má đào') && name.includes('vành đai')) return 'ma-dao-chay-toi-vdq';
  if (name.includes('nầm heo cháy tiêu') || name.includes('nầm cháy tiêu')) return 'nam-heo-chay-tieu';
  if (name.includes('ba chỉ chao giềng')) return 'ba-chi-chao-gieng';
  if (name.includes('nộm bò khế pháo')) return 'nom-bo-khe-phao';
  if (name.includes('dải chao tỏi')) return 'dai-chao-toi';
  if (name.includes('lẩu riêu cua') && name.includes('vành đai')) return 'lau-rieu-cua-vdq';
  if (name.includes('lẩu tôm bầu') && name.includes('vành đai')) return 'lau-tom-bau-vdq';
  if (name.includes('bia tháp')) return 'bia-thap';
  if (name.includes('bia cốc')) return 'bia-coc';
  
  // Bánh kem & Tráng miệng A Salty Name & Thanh Hằng Gateaux
  if (name.includes('cheesecake') || name.includes('cheese cake')) return 'cheesecake';
  if (name.includes('brownie')) return 'brownie';
