  if (name.includes('bento cake') || name.includes('bento')) return 'bento-cake';
  if (name.includes('chocomint')) return 'chocomint';
  if (name.includes('bánh kem sinh nhật') || name.includes('gateaux')) return 'gateaux-sinh-nhat';
  if (name.includes('mousse')) return 'mousse';
  if (name.includes('bông lan trứng muối')) return 'bong-lan-trung-muoi';
  if (name.includes('croissant') || name.includes('sừng bò')) return 'croissant';
  
  // Ăn vặt - Bánh tráng & Món kèm 55 Nguyễn Văn Linh
  if (name.includes('bánh tráng cuộn bơ') || name.includes('cuộn bơ')) return 'banh-trang-cuon-bo';
  if (name.includes('bánh tráng cuộn tóp mỡ') || name.includes('cuộn tóp mỡ')) return 'banh-trang-cuon-top-mo';
  if (name.includes('bánh tráng cuộn lòng đào') || name.includes('cuộn lòng đào')) return 'banh-trang-cuon-long-dao';
  if (name.includes('bánh tráng cuộn me') || name.includes('cuộn sốt me')) return 'banh-trang-cuon-me';
  if (name.includes('bánh tráng cuộn lắc mỡ hành') || name.includes('cuộn lắc mỡ hành')) return 'banh-trang-cuon-mo-hanh';
  if (name.includes('bánh tráng cuộn')) return 'banh-trang-cuon';
  if (name.includes('bánh tráng trộn') && name.includes('tóp mỡ')) return 'banh-trang-tron-top-mo';
  if (name.includes('bánh tráng trộn') && name.includes('mỡ hành')) return 'banh-trang-tron-mo-hanh';
  if (name.includes('bánh tráng trộn') && name.includes('sa tế')) return 'banh-trang-tron-sate';
  if (name.includes('bánh tráng trộn') && name.includes('phơi sương')) return 'banh-trang-tron-phoi-suong';
  if (name.includes('bánh tráng trộn')) return 'banh-trang-tron';
  if (name.includes('muối kẹo ly') || name.includes('muối kẹo')) return 'banh-trang-muoi-keo';
  if (name.includes('bánh tráng chấm') && name.includes('me')) return 'banh-trang-cham-me';
  if (name.includes('bánh tráng chấm') && name.includes('tắc')) return 'banh-trang-cham-tac';
  if (name.includes('bánh tráng chấm')) return 'banh-trang-cham';
  if (name.includes('bánh tráng nướng phô mai')) return 'banh-trang-nuong-pho-mai';
  if (name.includes('bánh tráng nướng')) return 'banh-trang-nuong';
  if (name.includes('bánh trứng cút nướng') || name.includes('trứng cút nướng')) return 'trung-cut-nuong';
  if (name.includes('bắp xào')) return 'bap-xao';
  // Chè & Tráng miệng
  if (name.includes('chè thập cẩm') && name.includes('xuân mai')) return 'che-xuan-mai-thap-cam';
  if (name.includes('chè bưởi')) return 'che-buoi';
  if (name.includes('chè khoai dẻo')) return 'che-khoai-deo';
  if (name.includes('chè đậu đỏ')) return 'che-dau-do';
  if (name.includes('chè dừa dầm')) return 'che-dua-dam';
  if (name.includes('sữa chua') && name.includes('xuân mai')) return 'sua-chua-xuan-mai';
  if (name.includes('chè')) return 'che';
  if (name.includes('buffet nem nướng') || name.includes('buffet nem')) return 'buffet-nem-nuong';
  if (name.includes('ram bắp')) return 'ram-bap';
  if (name.includes('nem lụi') || name.includes('nem nướng')) return 'nem-lui';
  if (name.includes('nem chua rán')) return 'nem-chua-ran';
  if (name.includes('nem')) return 'nem';
  if (name.includes('khoai lang kén') || name.includes('khoai')) return 'khoai';
  if (name.includes('đùi gà')) return 'dui-ga-lac';
  if (name.includes('gà chiên') || name.includes('cánh gà') || name.includes('gà rán') || name.includes('gà lắc')) return 'ga-chien';
  if (name.includes('mì cay bò mỹ') || (name.includes('mì cay') && name.includes('bò mỹ'))) return 'mi-cay-bo-my';
  if (name.includes('mì cay hải sản') || (name.includes('mì cay') && name.includes('hải sản'))) return 'mi-cay-hai-san';
  if (name.includes('mì thập cẩm') && name.includes('cấp độ')) return 'mi-cay-thap-cam-dac-biet';
  if (name.includes('mì sụn giòn') || name.includes('mì sụn')) return 'mi-cay-sun-gion';
  if (name.includes('tokbokki')) return 'tokbokki';
  if (name.includes('mỳ cay') || name.includes('mì cay')) return 'my-cay';
  if (name.includes('nước ép') || name.includes('ép cam') || name.includes('ép cóc')) return 'nuoc-ep';
  
  return name.split(' ').slice(0, 2).join(' ');
}

// Lọc lấy danh sách các món độc bản (mỗi món chỉ đại diện 1 lần, triệt tiêu trùng lặp)
export function getUniqueConceptFoods<T extends Food>(foods: T[]): T[] {
  const seenConcepts = new Set<string>();
  const seenImages = new Set<string>();
  const seenNames = new Set<string>();
  const result: T[] = [];
  
  for (const food of foods) {
    const concept = getDishConceptKey(food);
    const imgKey = food.customImage || `atlas_${food.image}`;
    const cleanName = food.name.toLowerCase().trim();
    
    if (!seenConcepts.has(concept) && !seenImages.has(imgKey) && !seenNames.has(cleanName)) {
      seenConcepts.add(concept);
      seenImages.add(imgKey);
      seenNames.add(cleanName);
      result.push(food);
    }
  }
  
  return result;
}

// Thuật toán đa dạng hóa món ăn tuyệt đối: Phân tán đều các nhóm món khác nhau, không để món cùng loại đứng cạnh nhau
export function diversifyFoodList<T extends Food>(foods: T[]): T[] {
  if (foods.length <= 2) return foods;

  const groups = new Map<string, T[]>();
  for (const food of foods) {
    const key = getDishConceptKey(food);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(food);
  }

  const keys = Array.from(groups.keys());
  const result: T[] = [];
  let round = 0;
  let added = true;

  while (added) {
    added = false;
    for (const key of keys) {
      const items = groups.get(key);
      if (items && items.length > round) {
        result.push(items[round]);
        added = true;
      }
    }
    round++;
  }

  return result;
}

