export type MainCategoryKey = 'an-gi' | 'nhau-gi' | 'uong-gi';

export interface MainCategory {
  id: MainCategoryKey;
  label: string;
  sub: string;
}

export const MAIN_CATEGORIES: MainCategory[] = [
  { id: 'an-gi', label: 'Hôm Nay Ăn Gì', sub: 'Phở, Bún, Cơm, Bánh mì, Mì cay, Xôi, Bánh đúc nóng, Ăn chiều nhẹ...' },
